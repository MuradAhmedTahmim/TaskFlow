# Copy this file to `.env` and fill in your values.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL (default). Create the database first:
#   CREATE DATABASE taskflow CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_ENGINE=mysql
DB_NAME=taskflow
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Set DB_ENGINE=sqlite to run without MySQL (quick local testing only).

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
# Extra allowed frontend origins (comma-separated). localhost on any port is
# already allowed while DJANGO_DEBUG=true.
CORS_ALLOWED_ORIGINS=
